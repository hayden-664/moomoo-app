# ---- OpenD (local gateway) -------------------------------------------------
# Leave as localhost. Exposing OpenD beyond 127.0.0.1 turns it into an
# internet-reachable endpoint tied to a live brokerage account.
OPEND_HOST=127.0.0.1
OPEND_PORT=11111

# ---- Account selection -----------------------------------------------------
# Run `curl localhost:8788/accounts` once OpenD is up to see the real values
# for your account, then set these to match.
#
# MOOMOO_TRD_MARKET:    US | HK | CN | SG | MY | AU | JP
# MOOMOO_SECURITY_FIRM: FUTUINC (moomoo US)  | FUTUMY (moomoo MY)
#                       FUTUSG  | FUTUAU | FUTUJP | FUTUCA
#                       FUTUSECURITIES (Futu HK)
# This must match the moomoo entity your account was opened under, not the
# market you want to trade. Getting it wrong yields an empty account list.
MOOMOO_TRD_MARKET=US
MOOMOO_SECURITY_FIRM=FUTUINC
MOOMOO_ACC_INDEX=0
MOOMOO_CURRENCY=USD

# ---- Sidecar ---------------------------------------------------------------
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8788
SIDECAR_URL=http://127.0.0.1:8788

# ---- Telegram --------------------------------------------------------------
# 1. Message @BotFather on Telegram, send /newbot, copy the token here.
# 2. Message your new bot once, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy result[0].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Alerts ----------------------------------------------------------------
ALERTS_ENABLED=true
ALERT_DAILY_TIME=08:30
ALERT_DAYS=mon-fri
ALERT_MOVE_ABS=75
ALERT_CHECK_MINUTES=15

# ---- Scheduled options screen ---------------------------------------------
# Sends the per-strike mechanical lines (cost, breakeven, required move, IV,
# liquidity) for what you hold. Contract mechanics only — this does not rank
# or recommend trades.
# Symbols in markets without option data are skipped, so this stays quiet
# until US options are activated on the account.
ALERT_SCREEN_ENABLED=true
ALERT_SCREEN_TIME=09:00
# Blank = derive from current positions. Or set e.g. US.NVDA,US.META
ALERT_SCREEN_CODES=
ALERT_SCREEN_MAX=5
ALERT_SCREEN_TYPE=CALL
ALERT_SCREEN_DTE_MIN=14
ALERT_SCREEN_DTE_MAX=45
ALERT_SCREEN_DELTA_MIN=0.2
ALERT_SCREEN_DELTA_MAX=0.45
ALERT_SCREEN_MIN_OI=250
