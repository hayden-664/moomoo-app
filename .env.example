# ---- OpenD (local gateway) -------------------------------------------------
# Leave as localhost. Exposing OpenD beyond 127.0.0.1 turns it into an
# internet-reachable endpoint tied to a live brokerage account.
OPEND_HOST=127.0.0.1
OPEND_PORT=11111

# ---- Account selection -----------------------------------------------------
# Run `curl localhost:8788/accounts` once OpenD is up to see the real values
# for your account, then set these to match.
#
# MOOMOO_TRD_MARKET:    US | HK | CN | SG | MY | AU | JP
# MOOMOO_SECURITY_FIRM: FUTUINC (moomoo US)  | FUTUMY (moomoo MY)
#                       FUTUSG  | FUTUAU | FUTUJP | FUTUCA
#                       FUTUSECURITIES (Futu HK)
# This must match the moomoo entity your account was opened under, not the
# market you want to trade. Getting it wrong yields an empty account list.
MOOMOO_TRD_MARKET=US
MOOMOO_SECURITY_FIRM=FUTUINC
MOOMOO_ACC_INDEX=0
MOOMOO_CURRENCY=USD

# ---- Sidecar ---------------------------------------------------------------
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8788
SIDECAR_URL=http://127.0.0.1:8788

# ---- Telegram --------------------------------------------------------------
# 1. Message @BotFather on Telegram, send /newbot, copy the token here.
# 2. Message your new bot once, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy result[0].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Alerts ----------------------------------------------------------------
ALERTS_ENABLED=true
ALERT_DAILY_TIME=08:30
ALERT_DAYS=mon-fri
ALERT_MOVE_ABS=75
ALERT_CHECK_MINUTES=15

# ---- Scheduled options screen ---------------------------------------------
# Sends the per-strike mechanical lines (cost, breakeven, required move, IV,
# liquidity) for what you hold. Contract mechanics only — this does not rank
# or recommend trades.
# Symbols in markets without option data are skipped, so this stays quiet
# until US options are activated on the account.
ALERT_SCREEN_ENABLED=true
ALERT_SCREEN_TIME=09:00
# Blank = derive from current positions. Or set e.g. US.NVDA,US.META
ALERT_SCREEN_CODES=
ALERT_SCREEN_MAX=5
ALERT_SCREEN_TYPE=CALL
ALERT_SCREEN_DTE_MIN=14
ALERT_SCREEN_DTE_MAX=45
ALERT_SCREEN_DELTA_MIN=0.2
ALERT_SCREEN_DELTA_MAX=0.45
ALERT_SCREEN_MIN_OI=250

# --- Paper trading engine ----------------------------------------------------
# Deterministic rules engine that places orders against moomoo's SIMULATED
# account. It is off unless you turn it on, and it cannot be pointed anywhere
# else: the account id and trading environment are module constants in
# sidecar/paper/guard.py, not settings. PAPER_ENABLED is the only lever.
#
# Sizing reads the REAL account's equity so results are at a realistic scale;
# every order is filled against the paper account. No real money moves.
PAPER_ENABLED=false   # set true to arm it

# How much of the engine reaches Telegram.
#   all     every order and every fill, plus halts (~12 messages a day at the
#           default caps, which buries the ones that matter)
#   alerts  halts, broker refusals, and a rules file that will not load. Rare.
#   off     nothing
# Everything it does is in the journal and on /paper regardless of this.
PAPER_NOTIFY=alerts
# Minutes between evaluations during US market hours.
#
# 15 is not arbitrary. The bar cache TTL is 1800s, so two cycles less than 30
# minutes apart read a byte-identical technicals payload and must reach the same
# conclusion - anything faster is pure repeated work. Against that, the
# pre-close cancel only fires if a cycle lands inside flatten_before_close_minutes
# (20), so the cycle has to be shorter than that. 15 satisfies both.
#
# Fill receipts do not depend on this: they are drained every 2 seconds while
# the engine sleeps, so a longer cycle never delays a Telegram message.
PAPER_CYCLE_MINUTES=15

# Evaluate new entries once per session at this US/Eastern time, rather than on
# every cycle. The rules read K_DAY bars, and mid-session that bar is still
# open: a MACD cross seen at 10:00 can be gone by the close, so an entry taken
# on it was taken on a signal that never existed. Evaluating late in the session
# acts on a bar that is essentially final.
#
# Must fall BEFORE the no-late-entries window (flatten_before_close_minutes,
# default 20, so before 15:40 ET) or every entry it evaluates is refused as a
# late entry. The engine logs a warning at startup if you get this wrong.
#
# Exits and the pre-close cancel are never gated by this - an open position has
# to be manageable on every cycle. Empty = evaluate entries every cycle.
PAPER_EVALUATE_AT=15:35
# Absolute ceiling on one order, independent of anything in rules.json.
PAPER_MAX_NOTIONAL_USD=25000
# Ceiling on a single rule's risk_pct. Loading a rules file that exceeds it is
# an error, not a clamp.
PAPER_MAX_RISK_PCT=2.0
# Strategy file. Version-controlled on purpose - a journal row records the hash
# of the rules that produced it, so a decision stays traceable to a commit.
# PAPER_RULES_PATH=sidecar/paper/rules.json
