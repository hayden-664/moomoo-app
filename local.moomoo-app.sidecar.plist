<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runs the sidecar automatically at login, so the alert scheduler and the paper
  trading engine are up whenever the Mac is, without starting anything by hand.

  This does NOT make either work while the Mac is asleep — nothing running
  locally can. Closing the lid on an Apple Silicon MacBook sleeps it unless an
  external display is attached, and a sleeping Mac evaluates nothing. Unlike the
  daily review, which launchd runs late on wake, a missed trading cycle is not
  worth replaying, so the engine simply skips it.

  The absolute path below is this repo's. Change it here and in
  local.moomoo-app.daily-review.plist if the repo moves.

  Install:
    cp local.moomoo-app.sidecar.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/local.moomoo-app.sidecar.plist

  Remove:
    launchctl unload ~/Library/LaunchAgents/local.moomoo-app.sidecar.plist
    rm ~/Library/LaunchAgents/local.moomoo-app.sidecar.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.moomoo-app.sidecar</string>

    <key>ProgramArguments</key>
    <array>
        <string>/private/var/my_projects/moomoo-app/run-sidecar.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/private/var/my_projects/moomoo-app</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart if it exits, e.g. after OpenD is restarted. -->
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/moomoo-sidecar.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/moomoo-sidecar.err.log</string>
</dict>
</plist>
